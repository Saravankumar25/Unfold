# Origin of the FastAPI service as seen from the Next.js *server* (never exposed to the browser).
# Read at runtime by the /api/* proxy Route Handler. In docker compose: API_INTERNAL_URL=http://api:8000
# On Vercel, set this to the public HTTPS origin of your deployed FastAPI service (without /api/v1).
API_INTERNAL_URL=http://localhost:8000
