# Copy to .env (git-ignored) and fill in. Values below work for local dev with `docker compose up -d`.
# Inside docker compose the app containers override *_URL/*_URI/ENDPOINT with service hostnames.

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
PUBLIC_WEB_ORIGIN=http://localhost:3010
COOKIE_SECURE=false

# --- stores ---
POSTGRES_USER=unfold
POSTGRES_PASSWORD=unfold
POSTGRES_DB=unfold
DATABASE_URL=postgresql+asyncpg://unfold:unfold@localhost:5432/unfold
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=unfold-neo4j-pass
QDRANT_URL=http://localhost:6333
OBJECT_STORE_ENDPOINT=localhost:9000
OBJECT_STORE_ACCESS_KEY=unfold
OBJECT_STORE_SECRET_KEY=unfold-minio-secret
OBJECT_STORE_BUCKET=unfold
OBJECT_STORE_SECURE=false

# --- LLM (Gemini is the V1 provider; keys are credentials, NOT extra quota) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Optional second provider (disabled when empty)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Model per capability tier (free-tier compatible; list available ones with `uv run poe llm-models`)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_BALANCED=gemini-3.5-flash
GEMINI_MODEL_REASONING=gemini-3.6-flash
# shared = all keys share one quota (safe default); per_key = operator asserts keys belong to separate projects
LLM_QUOTA_SCOPE=shared
# Optional JSON override of per-model limits, e.g. {"gemini-2.5-flash":{"rpm":10,"tpm":250000,"rpd":250,"concurrency":3}}
LLM_MODEL_LIMITS=
ANALYSIS_LLM_CALL_BUDGET=150

# --- local retrieval models (CPU, ONNX) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODEL_CACHE_DIR=.model-cache

# --- limits ---
SESSION_TTL_SECONDS=86400
SESSION_MAX_LIFETIME_SECONDS=259200
MAX_ZIP_BYTES=52428800
MAX_EXTRACTED_BYTES=314572800
MAX_FILE_COUNT=20000
MAX_SINGLE_FILE_BYTES=1048576
MAX_PATH_DEPTH=32
MAX_COMPRESSION_RATIO=100
MAX_REPO_ARCHIVE_BYTES=104857600

# --- optional ---
GITHUB_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=unfold

# --- network trust / abuse limits ---
# Only these peers may set X-Forwarded-For: set it to the address/CIDR of the web tier that proxies to the API,
# otherwise every user shares the proxy IP. Production refuses "*", COOKIE_SECURE=false and default credentials.
TRUSTED_PROXY_IPS=127.0.0.1
MAX_SESSIONS_PER_IP_PER_HOUR=20
MAX_SESSIONS_PER_HOUR=500
MAX_PROJECTS_PER_IP_PER_HOUR=30
MAX_PROJECTS_PER_HOUR_GLOBAL=200
